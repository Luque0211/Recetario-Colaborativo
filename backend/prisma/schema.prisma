generator client {
    provider            = "prisma-client"
    output              = "../src/generated"
    importFileExtension = "ts"
}

datasource db {
    provider = "postgresql"
}

model Usuario {
    id       Int    @id @default(autoincrement())
    nombre   String
    email    String @unique
    password String

    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    recetas   Receta[]
    favoritos Favorito[]
}

model Receta {
    id Int @id @default(autoincrement())

    usuarioId Int
    usuario   Usuario @relation(fields: [usuarioId], references: [id])

    titulo        String
    descripcion   String
    instrucciones String
    categoriaId   Int
    categoria     Categoria @relation(fields: [categoriaId], references: [id])

    ingredientes RecetaIngrediente[] // <-- ¡Relación añadida aquí!
    favoritos    Favorito[]
    createdAt    DateTime            @default(now())
    updatedAt    DateTime            @updatedAt
}

model Categoria {
    id     Int    @id @default(autoincrement())
    nombre String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    recetas   Receta[]
}

model Ingrediente {
    id        Int                 @id @default(autoincrement())
    nombre    String              @unique
    recetas   RecetaIngrediente[]
    createdAt DateTime            @default(now())
    updatedAt DateTime            @updatedAt
}

model RecetaIngrediente {
    id            Int         @id @default(autoincrement())
    recetaId      Int
    receta        Receta      @relation(fields: [recetaId], references: [id], onDelete: Cascade)
    ingredienteId Int
    ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)
    cantidad      String
}

model Favorito {
    id        Int     @id @default(autoincrement())
    usuarioId Int
    usuario   Usuario @relation(fields: [usuarioId], references: [id])
    recetaId  Int
    receta    Receta  @relation(fields: [recetaId], references: [id])
}
